# MAISON MIKIS - maisonmikis.fr
# URL canonique : https://www.maisonmikis.fr (AVEC www)
# Regroupe les 4 variantes du site sur une seule adresse, en 301.
# Les deux regles sont limitees au domaine maisonmikis.fr : aucun autre
# site heberge sur le meme compte ne peut etre affecte.

<IfModule mod_rewrite.c>
RewriteEngine On

# 1. Forcer HTTPS
# La 2e condition couvre le cas d'un proxy qui termine le TLS
# (sinon %{HTTPS} n'est jamais "on" cote Apache).
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteCond %{HTTP_HOST} (^|\.)maisonmikis\.fr$ [NC]
RewriteRule ^ https://www.maisonmikis.fr%{REQUEST_URI} [R=301,L]

# 2. Ajouter le www
RewriteCond %{HTTP_HOST} ^maisonmikis\.fr$ [NC]
RewriteRule ^ https://www.maisonmikis.fr%{REQUEST_URI} [R=301,L]


# 3. Articles retirés le 30/10/2026 (hors ligne éditoriale) : redirection
#    permanente vers l'article qui les remplace. Le serveur garde les anciens
#    fichiers (mise en ligne sans --delete) : ces règles passent avant eux.
RewriteRule ^actualites/fraude-audioprothese-rapport-igas-igf-100-sante\.html$ https://www.maisonmikis.fr/actualites/appareil-auditif-100-sante-sans-reste-a-charge.html [R=301,L]
RewriteRule ^actualites/resound-sensia-aide-auditive-ia-france\.html$ https://www.maisonmikis.fr/actualites/essai-appareil-auditif-avant-achat-deroulement.html [R=301,L]
RewriteRule ^actualites/nuance-audio-plus-lunettes-auditives-essilorluxottica\.html$ https://www.maisonmikis.fr/actualites/porter-lunettes-et-appareil-auditif-ensemble.html [R=301,L]
RewriteRule ^actualites/meta-lunettes-connectees-fonction-aide-auditive-fda\.html$ https://www.maisonmikis.fr/actualites/bilan-auditif-quel-age-comment-ca-se-passe.html [R=301,L]
RewriteRule ^actualites/teleexpertise-optique-alerte-snof-ophtalmologistes\.html$ https://www.maisonmikis.fr/actualites/dmla-premiers-signes-quand-consulter.html [R=301,L]
RewriteRule ^actualites/opticiens-ehpad-decret-2026-examens-vue\.html$ https://www.maisonmikis.fr/actualites/lunettes-apres-operation-cataracte.html [R=301,L]
RewriteRule ^actualites/projet-arrete-interdiction-publicite-optique-audition\.html$ https://www.maisonmikis.fr/actualites/progressifs-ou-lunettes-de-lecture-choisir.html [R=301,L]
RewriteRule ^actualites/publicite-optique-audition-projet-retire\.html$ https://www.maisonmikis.fr/actualites/verres-travail-ecran-bureau-apres-40-ans.html [R=301,L]
RewriteRule ^actualites/rapport-hubert-transfert-remboursement-mutuelles\.html$ https://www.maisonmikis.fr/actualites/choisir-monture-grande-maison-qui-dure.html [R=301,L]
RewriteRule ^actualites/lunettes-connectees-cepd-regles-vie-privee\.html$ https://www.maisonmikis.fr/actualites/taille-monture-lire-chiffres-branche.html [R=301,L]

</IfModule>

# ---------------------------------------------------------------------------
# Lot 1 du 27/10/2026 — vitesse (PageSpeed signalait ~800 Kio re-telecharges
# a chaque visite faute de mise en cache). Chaque bloc est entoure d'un
# IfModule : si le module n'existe pas chez l'hebergeur, la regle est ignoree
# sans erreur.
# ---------------------------------------------------------------------------

# Page d'erreur du site (generee par build.py, en noindex)
ErrorDocument 404 /404.html

# Compression des fichiers texte
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/javascript application/json image/svg+xml
</IfModule>

# Type MIME du WebP (au cas ou le serveur ne le connaitrait pas)
<IfModule mod_mime.c>
AddType image/webp .webp
</IfModule>

# Duree de conservation dans le navigateur
#  - pages HTML : jamais en cache (une mise en ligne est visible tout de suite)
#  - site.css : appele avec ?v=<empreinte>, change de nom a chaque modification -> 1 an
#  - images : 30 jours (une image remplacee sous le meme nom peut mettre
#    jusqu'a 30 jours a apparaitre chez un visiteur deja venu)
<IfModule mod_expires.c>
ExpiresActive On
ExpiresDefault "access plus 1 hour"
ExpiresByType text/html "access plus 0 seconds"
ExpiresByType text/css "access plus 1 year"
ExpiresByType application/javascript "access plus 1 year"
ExpiresByType image/webp "access plus 30 days"
ExpiresByType image/jpeg "access plus 30 days"
ExpiresByType image/png "access plus 30 days"
ExpiresByType image/svg+xml "access plus 30 days"
ExpiresByType image/x-icon "access plus 30 days"
ExpiresByType application/xml "access plus 1 hour"
ExpiresByType text/xml "access plus 1 hour"
</IfModule>
<IfModule mod_headers.c>
<FilesMatch "\.(html|htm)$">
Header set Cache-Control "no-cache"
</FilesMatch>
</IfModule>
